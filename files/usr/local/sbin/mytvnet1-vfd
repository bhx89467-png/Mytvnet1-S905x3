#!/usr/bin/env python3

import os
import re
import sys
import time
import subprocess
from datetime import datetime

AO_BASE = 597

STB = AO_BASE + 6
CLK = AO_BASE + 7
DIO = AO_BASE + 8

DELAY = 0.00002

# HT1628/TM1628 display RAM is 14 bytes: 0x00..0x0d
RAM_SIZE = 14

# Tested MytvNet1 display mapping
DIGIT_ADDR = [0, 2, 4, 6]
SIGN_ADDR = 8

ICON_POWER = 1 << 2
ICON_LAN = 1 << 3
ICON_COLON = 1 << 4
ICON_WIFI_HIGH = 1 << 5
ICON_WIFI_LOW = 1 << 6

WRITE_ADDRS = [0, 2, 4, 6, 8]

LAST_BUF = None

FRAME_SECONDS = 0.45
CLOCK_SECONDS = 8
LOOP_SLEEP = 0.2

# >= -67 dBm = high signal
WIFI_HIGH_DBM = -67

SEG7 = {
    "0": 0x3f,
    "1": 0x06,
    "2": 0x5b,
    "3": 0x4f,
    "4": 0x66,
    "5": 0x6d,
    "6": 0x7d,
    "7": 0x07,
    "8": 0x7f,
    "9": 0x6f,

    "A": 0x77,
    "B": 0x7c,
    "C": 0x39,
    "D": 0x5e,
    "E": 0x79,
    "F": 0x71,
    "G": 0x3d,
    "H": 0x76,
    "I": 0x06,
    "J": 0x1e,
    "L": 0x38,
    "N": 0x54,
    "O": 0x3f,
    "P": 0x73,
    "R": 0x50,
    "S": 0x6d,
    "T": 0x78,
    "U": 0x3e,
    "Y": 0x6e,

    "a": 0x5f,
    "b": 0x7c,
    "c": 0x58,
    "d": 0x5e,
    "e": 0x7b,
    "h": 0x74,
    "i": 0x04,
    "l": 0x06,
    "n": 0x54,
    "o": 0x5c,
    "r": 0x50,
    "t": 0x78,
    "u": 0x1c,

    "-": 0x40,
    "_": 0x08,
    "=": 0x48,
    " ": 0x00,
}


def log(msg):
    try:
        with open("/var/log/mytvnet1-vfd.log", "a") as f:
            f.write(f"{datetime.now().isoformat()} {msg}\n")
    except Exception:
        pass


def write_file(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def read_file(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default


def run(cmd):
    try:
        return subprocess.check_output(
            cmd,
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
    except Exception:
        return ""


def export_gpio(n):
    if not os.path.exists(f"/sys/class/gpio/gpio{n}"):
        try:
            write_file("/sys/class/gpio/export", n)
            time.sleep(0.05)
        except OSError:
            pass

    write_file(f"/sys/class/gpio/gpio{n}/direction", "out")


def set_gpio(n, value):
    write_file(
        f"/sys/class/gpio/gpio{n}/value",
        1 if value else 0
    )


def setup_gpio():
    for gpio in (STB, CLK, DIO):
        export_gpio(gpio)

    set_gpio(STB, 1)
    set_gpio(CLK, 1)
    set_gpio(DIO, 1)

    time.sleep(0.05)


def pulse_clk():
    set_gpio(CLK, 0)
    time.sleep(DELAY)

    set_gpio(CLK, 1)
    time.sleep(DELAY)


def write_byte_lsb(value):
    for i in range(8):
        set_gpio(DIO, (value >> i) & 1)
        pulse_clk()


def cmd(value):
    set_gpio(STB, 0)
    write_byte_lsb(value)
    set_gpio(STB, 1)

    time.sleep(0.001)


def init_display():
    cmd(0x03)
    cmd(0x8F)


def write_one(addr, value):
    # Known-good normal write mode.
    # Write only one RAM byte to avoid display flicker.
    cmd(0x40)

    set_gpio(STB, 0)

    write_byte_lsb(0xC0 | (addr & 0x0F))
    write_byte_lsb(value & 0xFF)

    set_gpio(STB, 1)

    time.sleep(0.0005)


def send_buf(buf, force=False):
    global LAST_BUF

    buf = list(buf[:RAM_SIZE])
    buf += [0] * max(0, RAM_SIZE - len(buf))

    if LAST_BUF is None:
        LAST_BUF = [None] * RAM_SIZE

    for addr in WRITE_ADDRS:
        if force or LAST_BUF[addr] != buf[addr]:
            write_one(addr, buf[addr])
            LAST_BUF[addr] = buf[addr]


def make_buf(text="    ", icons=0):
    buf = [0x00] * RAM_SIZE

    text = (text + "    ")[:4]

    for i, ch in enumerate(text):
        value = SEG7.get(
            ch,
            SEG7.get(ch.upper(), 0x00)
        )
        buf[DIGIT_ADDR[i]] = value

    buf[SIGN_ADDR] = icons

    return buf


def show(text, icons=0, force=False):
    send_buf(
        make_buf(text, icons),
        force=force
    )


def iface_carrier(iface):
    return read_file(
        f"/sys/class/net/{iface}/carrier",
        "0"
    ) == "1"


def iface_oper_up(iface):
    return read_file(
        f"/sys/class/net/{iface}/operstate",
        ""
    ) in ("up", "unknown")


def ip4_addr(iface):
    out = run([
        "ip",
        "-4",
        "-o",
        "addr",
        "show",
        "dev",
        iface
    ])

    match = re.search(
        r"inet\s+(\d+\.\d+\.\d+\.\d+)/",
        out
    )

    return match.group(1) if match else ""


def ssh_connected():
    out = run([
        "ss",
        "-Htn",
        "state",
        "established",
        "sport",
        "=",
        ":22"
    ])

    if out:
        return True

    # fallback
    who = run(["who"])

    return bool(
        who and
        re.search(r"\(\d+\.\d+\.\d+\.\d+\)", who)
    )


def wifi_connected(iface="wlan0"):
    if not os.path.exists(
        f"/sys/class/net/{iface}"
    ):
        return False

    out = run([
        "iw",
        "dev",
        iface,
        "link"
    ])

    if "Connected to" in out:
        return True

    return (
        iface_oper_up(iface) and
        bool(ip4_addr(iface))
    )


def wifi_signal_dbm(iface="wlan0"):
    out = run([
        "iw",
        "dev",
        iface,
        "link"
    ])

    match = re.search(
        r"signal:\s*(-?\d+)\s*dBm",
        out
    )

    if match:
        return int(match.group(1))

    return None


def current_status():
    lan = iface_carrier("eth0")
    ssh = ssh_connected()

    wifi = wifi_connected("wlan0")

    signal = (
        wifi_signal_dbm("wlan0")
        if wifi
        else None
    )

    wifi_high = (
        signal is not None and
        signal >= WIFI_HIGH_DBM
    )

    return {
        "lan": lan,
        "ssh": ssh,
        "wifi": wifi,
        "wifi_high": wifi_high,
        "wifi_signal": signal,
        "eth_ip": ip4_addr("eth0"),
        "wlan_ip": ip4_addr("wlan0"),
    }


def icons_from_status(status, colon=False):
    icons = 0

    # SSH connection = power icon
    if status["ssh"]:
        icons |= ICON_POWER

    # Ethernet carrier
    if status["lan"]:
        icons |= ICON_LAN

    # Wi-Fi connected:
    # low signal  -> low icon
    # high signal -> low + high
    if status["wifi"]:
        icons |= ICON_WIFI_LOW

        if status["wifi_high"]:
            icons |= ICON_WIFI_HIGH

    if colon:
        icons |= ICON_COLON

    return icons


def format_ip(prefix, ip):
    if not ip:
        return f"{prefix}--- --- --- ---"

    parts = ip.split(".")

    if len(parts) != 4:
        return f"{prefix}--- --- --- ---"

    padded = [
        part.zfill(3)
        for part in parts
    ]

    return (
        prefix +
        padded[0] + " " +
        padded[1] + " " +
        padded[2] + " " +
        padded[3]
    )


def show_ip_marquee(status):
    # Example:
    #
    # E192 168 003 001 F192 168 004 009
    #
    # Scroll one character/digit at a time across 4-digit display.

    eth = format_ip(
        "E",
        status["eth_ip"]
    )

    wlan = format_ip(
        "F",
        status["wlan_ip"]
    )

    text = (
        "    " +
        eth +
        "    " +
        wlan +
        "    "
    )

    for pos in range(len(text) - 3):
        frame = text[pos:pos + 4]

        fresh = current_status()

        show(
            frame,
            icons_from_status(fresh)
        )

        time.sleep(FRAME_SECONDS)


def show_clock(seconds=CLOCK_SECONDS):
    end = time.time() + seconds
    colon = False

    while time.time() < end:
        now = datetime.now()

        text = (
            f"{now.hour:02d}"
            f"{now.minute:02d}"
        )

        colon = not colon

        status = current_status()

        show(
            text,
            icons_from_status(
                status,
                colon=colon
            )
        )

        time.sleep(1)


def main():
    global LAST_BUF

    setup_gpio()
    init_display()

    LAST_BUF = None

    # Early oneshot:
    #
    # mytvnet1-vfd once boot
    #
    if len(sys.argv) >= 2 and sys.argv[1] == "once":
        text = (
            sys.argv[2]
            if len(sys.argv) >= 3
            else "    "
        )

        show(
            text,
            0,
            force=True
        )

        return

    log("daemon started")

    while True:
        status = current_status()

        if status["ssh"]:
            # SSH active:
            # clock + power icon + network icons
            show_clock()

        else:
            # No SSH:
            # E<eth IP> -> F<wlan IP> marquee
            # then clock
            # then repeat
            show_ip_marquee(status)
            show_clock()

        time.sleep(LOOP_SLEEP)


if __name__ == "__main__":
    try:
        main()

    except Exception as exc:
        log(f"fatal: {exc!r}")
        raise
        